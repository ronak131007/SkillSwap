# SkillSwap environment configuration. Copy to .env and fill in real values.
# .env is gitignored; never commit secrets.

# HTTP port for the Spring Boot service (API + built frontend in production)
PORT=8787

# Any of these set to production/prod enables Secure cookies, CSP/HSTS and disables dev console links/codes.
# Leave unset (or development) for local work; npm start passes -DAPP_ENV=production.
# NODE_ENV=development
# APP_ENV=
# SPRING_PROFILES_ACTIVE=

# Secret used to hash one-time email codes and 2FA recovery codes.
# REQUIRED in production; generate a long random string (32+ bytes).
APP_SECRET=change-me-to-a-long-random-string

# Comma-separated allowlist for cross-origin API calls.
# Defaults to http://localhost:5173,http://127.0.0.1:5173 in development when unset.
CORS_ORIGIN=http://localhost:5173

# Frontend base URL used for post-OAuth redirects and verification links in development.
FRONTEND_URL=http://localhost:5173

# Public backend base URL used to construct OAuth2 callback redirect URIs.
# Change to http://localhost:8080 if you set PORT=8080.
PUBLIC_BASE_URL=http://localhost:8787

# Optional SQLite database path; defaults to ./data/skillswap.db
SKILLSWAP_DB=./data/skillswap.db

# First-admin bootstrap (used ONLY on startup when zero admin accounts exist in the database).
# Leave empty to start with zero users. When set, the password is hashed with bcrypt (never logged)
# and the admin is forced to change it on first sign-in (mustChangePassword = true).
# Password must be 10+ chars with uppercase, lowercase and a digit.
ADMIN_EMAIL=
ADMIN_INITIAL_PASSWORD=

# Social OAuth2 credentials (server-side ONLY — never expose client IDs or secrets with VITE_*).
# See docs/OAUTH_SETUP.md for step-by-step setup instructions, redirect URIs and scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

TWITTER_CLIENT_ID=
TWITTER_CLIENT_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# SMTP (optional; when unset in development, verification/reset links and codes print to the server console)
SMTP_URL=
