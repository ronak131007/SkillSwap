{
  "name": "skillswap",
  "version": "2.4.9",
  "private": true,
  "description": "SkillSwap - peer-to-peer student skill exchange platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server:java\" \"npm:dev:web\"",
    "dev:win": "concurrently -k -n api,web -c cyan,magenta \"mvnw.cmd spring-boot:run\" \"vite\"",
    "dev:node": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:server:node\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts",
    "dev:server:node": "npm run dev:server",
    "dev:server:java": "node scripts/mvnw.mjs spring-boot:run",
    "build": "vite build",
    "build:java": "node scripts/mvnw.mjs -DskipTests package",
    "start": "node scripts/mvnw.mjs spring-boot:run -Dspring-boot.run.jvmArguments=-DAPP_ENV=production",
    "start:java": "node scripts/mvnw.mjs spring-boot:run -Dspring-boot.run.jvmArguments=-DAPP_ENV=production",
    "start:jar": "java -DAPP_ENV=production -jar target/skillswap-backend-2.4.9.jar",
    "start:node": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:java": "node scripts/mvnw.mjs test",
    "seed": "tsx server/seed.ts",
    "seed:java": "node scripts/mvnw.mjs spring-boot:run -Dspring-boot.run.arguments=--seed",
    "e2e:java": "bash scripts/e2e.sh"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "better-sqlite3": "13.0.3",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dexie": "4.4.7",
    "dompurify": "3.4.17",
    "express": "4.22.3",
    "express-rate-limit": "7.5.1",
    "helmet": "8.3.0",
    "lucide-react": "1.70.0",
    "otplib": "13.6.0",
    "qrcode": "1.5.4",
    "react": "^18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "recharts": "2.15.4",
    "zod": "3.25.76",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/cookie-parser": "1.4.10",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "22.20.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.6.2",
    "concurrently": "10.0.7",
    "postcss": "8.5.32",
    "tailwindcss": "3.4.19",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "5.4.21",
    "vitest": "2.1.9"
  }
}
